{
  "name": "pi-bili-scroll",
  "version": "0.1.0",
  "description": "Pi 包：每天替你刷一轮 B 站 —— 读字幕原文挑出值得的、写一份日报。一条命令 + 判据 skill + 自带的 B 站 MCP 声明，装一个包即可用。",
  "type": "module",
  "license": "MIT",
  "author": "swordfate3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swordfate3/pi-bili-scroll.git"
  },
  "homepage": "https://github.com/swordfate3/pi-bili-scroll#readme",
  "bugs": {
    "url": "https://github.com/swordfate3/pi-bili-scroll/issues"
  },
  "keywords": [
    "pi-package",
    "bilibili",
    "mcp",
    "scroll"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./resources/skills"
    ],
    "mcp": "./mcp.json"
  },
  "files": [
    "src",
    "resources",
    "mcp.json",
    "README.md",
    "ARCHITECTURE.md",
    "DECISIONS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6"
  }
}
